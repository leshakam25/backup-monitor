# Задания бекапа этой машины. После сохранения изменения применятся сами в течение 10 минут
# (итог придёт в бот как задание «jobs.psd1»). Применить сразу: Install.cmd -Apply
#
# Имя задания (ключ) — как оно будет видно в боте: буквы, цифры, пробел, точка, дефис, подчёркивание.
#
# Параметры задания:
#   Sources     — папки/файлы, одна строка или несколько через запятую; маски можно: 'D:\Docs\*.docx'
#                 сетевые папки тоже можно: '\\192.168.1.20\Docs' (снимок VSS для них не делается).
#                 Если ресурс просит логин/пароль: Install.cmd -Credential \\192.168.1.20
#   Schedule    — расписание:
#                   'Daily 01:00'              каждый день в 01:00
#                   'Daily 09:00, 13:00, 18:00' несколько раз в день
#                   'Every 4h'                 каждые 4 часа с полуночи;  'Every 4h from 08:00'
#                   'Weekly Mon,Thu 02:00'     по дням недели (Mon Tue Wed Thu Fri Sat Sun)
#   Exclude     — маски исключений: '*.tmp', '~$*'
#   Destination — куда класть архивы. По умолчанию: NasRoot\ИмяЗадания (NasRoot — в agent.config.psd1)
#   KeepDays    — удалять архивы старше N дней (по умолчанию 14), но всегда оставлять MinKeep последних (3)
#   Password    — пароль на архив. Пишите открытым текстом — при -Apply он заменится зашифрованным
#   UseVss      — $false, чтобы не делать снимок тома (по умолчанию снимок делается)
#   Format      — '7z' (по умолчанию) или 'zip';  Level — сжатие 0..9 (по умолчанию 5)
#   Test        — $false, чтобы не проверять архив после создания (7z t)
#   Enabled     — $false, чтобы временно отключить задание, не удаляя его
#
# Задания выполняются строго по одному: если время совпало, второе подождёт первое.
# Базы 1С и открытые документы архивируются со снимка тома (VSS) — пользователей выгонять не нужно.
# Бекап 1С лучше ставить на ночь и раз в месяц проверять восстановление
# (развернуть копию и прогнать «Тестирование и исправление»).
@{
    '1C_Buh' = @{
        Sources  = 'D:\1C\Buh'
        Exclude  = '1Cv8tmp.1CD'
        Schedule = 'Daily 01:00'
        KeepDays = 30
    }

    '1C_ZUP' = @{
        Sources  = 'D:\1C\ZUP'
        Exclude  = '1Cv8tmp.1CD'
        Schedule = 'Daily 01:00'
    }

    'Docs' = @{
        Sources  = 'D:\Docs', 'D:\Scans'
        Exclude  = '*.tmp', '~$*', 'Thumbs.db'
        Schedule = 'Daily 22:00'
    }
}
