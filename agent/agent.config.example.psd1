# Настройки агента. Обычно этот файл создаёт Install.cmd (agent.config.psd1) — править вручную не нужно.
# Все параметры, кроме ServerUrl и Token, необязательные.
@{
    # Адрес приёма отчётов и токен компании (бот: Компании -> компания -> Токен)
    ServerUrl   = 'https://backup.example.ru/api/report'
    Token       = 'ВСТАВЬТЕ-ТОКЕН-СЮДА'

    # NAS: корневая сетевая папка; каждое задание пишет в свою подпапку NasRoot\ИмяЗадания.
    # Логин/пароль сюда НЕ пишутся: Install.cmd сохраняет их в Диспетчер учётных данных Windows
    # (хранилище SYSTEM, от имени которого работают задания). Добавить/сменить: Install.cmd -Credential \\192.168.1.10
    NasRoot     = '\\192.168.1.10\backup'

    # Путь к 7z.exe
    SevenZip    = 'C:\Program Files\7-Zip\7z.exe'

    # Логи, очередь неотправленных отчётов, временные архивы и ссылки на снимки VSS
    WorkDir     = 'C:\BackupAgent\data'
    # Временная папка для архива до копирования на NAS (нужно место размером с самый большой архив).
    # По умолчанию WorkDir\staging; можно вынести на диск, где больше места.
    #StagingDir = 'E:\BackupStaging'

    # Значения по умолчанию для всех заданий (в jobs.psd1 можно переопределить)
    #UseVss     = $true
    #KeepDays   = 14
    #MinKeep    = 3
    #Format     = '7z'
    #Level      = 5

    # Имя компьютера в отчётах (по умолчанию — имя компьютера)
    #HostName   = ''
    # Сколько ждать своей очереди, если предыдущее задание ещё идёт (минут)
    #LockTimeoutMinutes = 720
    # Сколько дней хранить логи и сколько отчётов максимум держать в очереди
    #LogKeepDays = 30
    #QueueLimit  = 500
}
