# ===== Docker / Traefik =====
# vpn — запускать контейнер amnezia. Если VDS за границей и VPN не нужен:
# COMPOSE_PROFILES=  и  TELEGRAM_PROXY=  (оба пустые)
COMPOSE_PROFILES=vpn

# Домен, на который агенты шлют отчёты (A-запись -> IP вашего VDS)
DOMAIN=backup.example.ru
# Почта для Let's Encrypt
ACME_EMAIL=admin@example.ru

# ===== Бот =====
BOT_TOKEN=123456789:AAAA-замените-на-свой
ADMIN_IDS=111111111
NOTIFY_CHAT_IDS=
TZ_NAME=Europe/Moscow
SUMMARY_TIME=09:00
NOTIFY_SUCCESS=true
SUCCESS_SILENT=true
GRACE_FACTOR=1.25
GRACE_MINUTES=15
MISSED_REPEAT_HOURS=24
SIZE_DROP_RATIO=0.5
RUNS_KEEP_DAYS=365

# Прокси до Telegram. Не задано — через контейнер amnezia (http://amnezia:8888).
# Пустое значение (TELEGRAM_PROXY=) — напрямую, без VPN.
#TELEGRAM_PROXY=
