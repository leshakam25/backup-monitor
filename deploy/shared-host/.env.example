# /opt/backup_bot/.env на сервере (chmod 600). Заполните BOT_TOKEN и ADMIN_IDS.

# Домен приёма отчётов (A-запись -> IP сервера). Используется в метках Traefik
# и подставляется в архив агента как адрес сервера по умолчанию.
DOMAIN=backup.example.ru

# Токен бота от @BotFather
BOT_TOKEN=
# Telegram id админов через запятую. Пусто — бот на любое сообщение ответит вашим id.
ADMIN_IDS=
# Куда слать уведомления. Пусто = в личку всем из ADMIN_IDS. Можно id группы (отрицательный).
NOTIFY_CHAT_IDS=

TZ_NAME=Europe/Moscow
SUMMARY_TIME=09:00
NOTIFY_SUCCESS=true
SUCCESS_SILENT=true
GRACE_FACTOR=1.25
GRACE_MINUTES=15
MISSED_REPEAT_HOURS=24
SIZE_DROP_RATIO=0.5
RUNS_KEEP_DAYS=365

# Прокси до Telegram. Не задано — внешний AWG-прокси http://awg:3128.
# Пустое значение (TELEGRAM_PROXY=) — напрямую с IP сервера.
#TELEGRAM_PROXY=
