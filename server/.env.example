# Скопируйте в .env и заполните.

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-замените-на-свой

# Telegram id тех, кто может пользоваться ботом (через запятую).
# Узнать свой id: напишите боту что угодно — он ответит вашим id.
ADMIN_IDS=111111111

# Куда слать уведомления (через запятую). Пусто = в личку всем из ADMIN_IDS.
# Можно указать id группы (отрицательное число), если бот в ней состоит.
NOTIFY_CHAT_IDS=

# Где слушать отчёты агентов. За Caddy/nginx — оставьте 127.0.0.1.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080

DB_PATH=backup_bot.sqlite3
TZ_NAME=Europe/Moscow

# Утренняя сводка (ЧЧ:ММ) или off
SUMMARY_TIME=09:00

# Присылать уведомления об успешных бекапах
NOTIFY_SUCCESS=true
# Успешные приходят без звука (ошибки, пропуски и восстановления — всегда со звуком)
SUCCESS_SILENT=true

# Бекап считается пропавшим, если отчёта нет дольше: интервал * GRACE_FACTOR + GRACE_MINUTES
GRACE_FACTOR=1.25
GRACE_MINUTES=15
# Напоминать о пропавшем бекапе каждые N часов (0 — не напоминать)
MISSED_REPEAT_HOURS=24

# Если архив меньше обычного в эту долю (0.5 = вдвое) — успешный бекап помечается предупреждением. 0 — выключить.
SIZE_DROP_RATIO=0.5

# Сколько дней хранить историю запусков
RUNS_KEEP_DAYS=365

# Если без Caddy/nginx и нужен HTTPS прямо из бота — пути к сертификату и ключу
SSL_CERT=
SSL_KEY=

# Прокси для запросов к Telegram (например, через контейнер с VPN): http://host:port или socks5://host:port
TELEGRAM_PROXY=
